; obrien enhanced recoil DLTX

; copying base ammo and info from original ltx.
[cam_anim_1]
    frames_peak     = 0.33                          ;; Can't measure it at 30hz, it also looks terrible

[cam_anim_2]
    frames_peak     = 0.67                          ;; This one also looks terrible

[cam_anim_3]
    frames_peak     = 1

[cam_anim_4]
    frames_peak     = 2

[cam_anim_5]
    frames_peak     = 3

[base_recoil]
    cam_anim    = 5                                 ;; Pick one of the 5 cam_anim_ sections
    cam_shake   = 0.5, 0.5, 0.25                    ;; Horizontal shake, vertical shake, camera roll
    cam_recoil  = 0.5, 1.0:0                        ;; Horizontal recoil, vertical recoil
    cam_fov     = 1.0                               ;; How far back to pull the camera 
    gun_shake_k = -0.1                              ;; Gun movement coefficient -- (cam_shake * gun_shake_k)
    max_recoil  = 1.0                               ;; Max recoil divisor -- (1 + max_recoil)
    max_shots   = 1                                 ;; Consecutive shots needed to reach max_recoil
    hburst_k    = 1.0                               ;; Neutral misc. modifiers
    variance_k  = 1.0
    h_max_r_k   = 1.0
    h_var_k     = 1.0
    cam_return  = false                             ;; Disable GOLD's recoil auto reset "feature" by default
    reset_k     = 1.0
    force_norm  = false
    postprocess =                                   ;; No default post process effects

