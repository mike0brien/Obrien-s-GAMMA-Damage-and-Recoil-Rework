		["fire_wound_cap"]				= { index= 24,	typ= "float",	name= "gamma_fire_wound_cap",					icon_p= "gamma_fire_wound",					icon_n= "ui_am_prop_fire_wound_negative",	track= false, magnitude= 100,							unit= "st_perc",		condition= false,	compare= false,	sign= true,		show_always= false	},
