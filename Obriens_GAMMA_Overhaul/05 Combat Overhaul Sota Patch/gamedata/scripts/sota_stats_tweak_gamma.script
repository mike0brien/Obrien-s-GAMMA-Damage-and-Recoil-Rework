-- ========== OBRIEN DAMAGE REWORK COMPATIBILITY ================================================================
-- The damage script is the sole source of protection math.
-- This file does not overwrite any grok_actor_damage_balancer combat functions.
local gadb = grok_actor_damage_balancer

-- Keep SOTA's lookup table complete, but do not alter the damage-script constants.
gadb.protection_to_hit_type["Radiation"] = hit.radiation
local prot_to_hit_type = gadb.protection_to_hit_type

local mitigation_table_body = gadb.mitigation_table_body
local mitigation_table_head = gadb.mitigation_table_head

-- Values consumed by the rest of this UI script. They are populated exclusively
-- from the return values of the current damage script.
local hit_type
local immunity
local protection
local booster_type_def
local adjuster
local arti_adjuster
local limiter
local elemental
local psy
local cap_stat
local defense
local premitigation

local function get_adb_constants(st)
    -- Radiation uses SOTA's proven UI-only conversion. All other damage types
    -- come directly from the O'Brien damage script without SOTA multipliers.
    if st == hit.radiation or st == "Radiation" or st == "radiation" then
        hit_type = 3 -- UI-only engine Radiation hit type
        immunity = "radiation_immunity"
        protection = "Radiation"
        booster_type_def = 5
        adjuster = 10 * stat_radia.magn
        arti_adjuster = (1) * 100 * stat_radia.magn
        limiter = 1.0
        elemental = 1
        psy = 0
        cap_stat = nil
        defense = "radiation_protection"
        premitigation = 0
    else
        hit_type,
        immunity,
        protection,
        booster_type_def,
        adjuster,
        arti_adjuster,
        limiter,
        elemental,
        psy,
        cap_stat,
        defense = gadb.get_adb_constants(st)

        adjuster = adjuster or 1.0
        arti_adjuster = arti_adjuster or 1.0
        limiter = limiter or 0
        elemental = elemental or 0
        psy = psy or 0
        premitigation = 0
    end

    return hit_type, immunity, protection, booster_type_def, adjuster,
           arti_adjuster, limiter, elemental, psy, cap_stat, defense
end
-- Shared constants for SOTA's booster/upgrade UI. No SOTA-specific balance
-- multipliers are introduced here.
gadb_const = {
    ["Radiation"]    = { booster_name = "boost_radiation_protection" },
    ["ChemicalBurn"] = { booster_name = "boost_chemburn_protection" },
    ["Shock"]        = { booster_name = "boost_shock_immunity" },
    ["Burn"]         = { booster_name = "boost_burn_immunity" },
    ["Telepatic"]    = { booster_name = "boost_telepat_protection" },
    ["Wound"]        = { booster_name = "boost_wound_immunity" },
    ["Strike"]       = { booster_name = "boost_strike_immunity" },
    ["Explosion"]    = { booster_name = "boost_explosion_immunity" },
    ["FireWound"]    = { booster_name = "boost_fire_wound_immunity" },
}

for name, values in pairs(gadb_const) do
    get_adb_constants(name)
    values.booster_type_def = booster_type_def
    values.adjuster = adjuster
    values.arti_adjuster = arti_adjuster

    -- Actual damage uses the raw booster value for every type except telepathic,
    -- where the damage script multiplies it by both adjusters.
    values.boost_adjuster = 1.0
    if name == "Radiation" then
        values.boost_adjuster = 100 / 0.7
    elseif name == "Telepatic" then
        values.boost_adjuster = adjuster * arti_adjuster
    end
end

-- Use the isolated O'Brien protection function for SOTA's equipped-stat preview.
-- We do not assign it back to gadb.get_protection, so SOTA cannot affect combat.
-- Any k_ap supplied here is UI-only and never reaches shit_booster.
local get_protection = gadb.get_protection_obrien or gadb.get_protection

-- The damage-script getter already includes condition in FireWound object values. Sota was adding it again, removing that so UI only applies it once.
-- returned as full-condition base values by the damage script.
local damage_get_outfit_value = gadb.get_outfit_value
local damage_get_outfit_ap_res = gadb.get_outfit_ap_res
local damage_get_af_value = gadb.get_af_value

local function normalize_damage_stat_name(name)
    -- The damage script uses lowercase "radiation", while SOTA's UI tables, not fixing that, basically or it.
    return (name == "Radiation") and "radiation" or name
end

local function get_outfit_value(obj, sec, name, def)
    -- Do not route Radiation through the generic damage getter. In the current
    -- damage script its lowercase Radiation branch supplies a nil HitTypeID,
    -- while the vanilla UI correctly reads engine hit type 3 (Radiation).
    -- Return the same base units as the other outfit getter: raw value * 100,
    -- with object condition removed because SOTA applies condition externally.
    if name == "Radiation" or name == "radiation" then
        get_adb_constants("Radiation")

        if obj then
            local outfit = IsOutfit(obj)
            local helmet = IsHeadgear(obj)
            local cond = obj:condition()
            local cobj = outfit and obj:cast_CustomOutfit() or helmet and obj:cast_Helmet()
            if not cobj then
                return def or 0
            end
            if (not cond) or cond <= 0 then
                cond = 1
            end
            return (cobj:GetDefHitTypeProtection(hit_type) or 0) * adjuster * 100 / cond
        elseif sec then
            return (SYS_GetParam(2, sec, defense, def or 0) or 0) * adjuster * 100
        end

        return def or 0
    end

    local damage_name = normalize_damage_stat_name(name)
    local value = damage_get_outfit_value(obj, sec, damage_name, def)
    if value == nil then
        return def or 0
    end

    if obj and name == "FireWound" then
        local cond = obj:condition()
        if cond and cond > 0 then
            value = value / cond
        end
    end

    return value
end

-- These damage-script getters return base values without item condition.
-- SOTA's existing UI code applies condition exactly once.
local function get_outfit_ap_res(obj)
    return damage_get_outfit_ap_res(obj) or 0
end

local function get_af_value(obj, sec, name, def)
    -- Radiation artefacts use their raw immunity value. SOTA/vanilla applies
    -- condition outside this getter and normalizes it against radiation max.
    if name == "Radiation" or name == "radiation" then
        if not sec and obj then
            sec = obj:section()
        end
        if not sec then
            return def or 0
        end

        get_adb_constants("Radiation")
        local immunities_sec = SYS_GetParam(0, sec, "hit_absorbation_sect", sec)
        local prot = SYS_GetParam(2, immunities_sec, immunity, def or 0) or 0
        return prot * arti_adjuster
    end

    local damage_name = normalize_damage_stat_name(name)
    local value = damage_get_af_value(obj, sec, damage_name, def)
    if value == nil then
        return def or 0
    end
    return value
end

-- SOTA's item tooltip system resolves these names dynamically through the
-- damage-script namespace. Export only the condition-safe UI adapters; combat
-- does not call these functions.
gadb.get_outfit_value = get_outfit_value
gadb.get_outfit_ap_res = get_outfit_ap_res
gadb.get_af_value = get_af_value
-- ========== END OBRIEN DAMAGE REWORK COMPATIBILITY ============================================================


