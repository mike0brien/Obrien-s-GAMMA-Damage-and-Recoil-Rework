local DEBUG = false

local function dlog(message)
    if DEBUG then
        log(message)
    end
end

dlog("=== Armor Recoil Loaded ===")

local armor_recoil = {}

-- =========================
-- armor multiplier table
-- =========================
armor_recoil.armor_table = {
    ["army_nosorog_outfit"] = 0.85,
    ["dolg_nosorog_outfit"] = 0.85,
    ["freedom_nosorog_outfit"] = 0.85,
    ["isg_nosorog_outfit"] = 0.85,
    ["merc_nosorog_outfit"] = 0.85,
    ["monolith_nosorog_outfit"] = 0.85,

    ["exo_outfit"] = 0.8,
    ["bandit_exo_outfit"] = 0.9,
    ["cs_exo_outfit"] = 0.8,
    ["dolg_exo_outfit"] = 0.8,
    ["ecolog_exo_outfit"] = 0.85,
    ["greh_exo_outfit"] = 0.8,
    ["isg_exo_outfit"] = 0.8,
    ["merc_exo_outfit"] = 0.8,
    ["military_exo_outfit"] = 0.8,
    ["monolith_exo_outfit"] = 0.8,
    ["renegade_exo_outfit"] = 0.9,
    ["svoboda_exo_outfit"] = 0.8,

    ["military_proto_exo_outfit"] = 0.75,
    ["dolg_heavy_proto_exo_outfit"] = 0.75,
    ["stalker_proto_exo_outfit"] = 0.65,
    ["cs_stalker_proto_exo_outfit"] = 0.72,
    ["dolg_proto_exo_outfit"] = 0.70,
    ["ecolog_proto_exo_outfit"] = 0.7,
    ["isg_proto_exo_outfit"] = 0.7,
    ["monolith_proto_exo_outfit"] = 0.71,
    ["svoboda_light_proto_exo_outfit"] = 0.7
}

local DEFAULT_MULT = 1.0

armor_recoil.current_mult = DEFAULT_MULT
armor_recoil.current_weapon_id = nil
armor_recoil.current_armor_section = nil

-- Standalone mode needs to remember the weapon's engine/upgraded frac values
-- so armor can be applied without permanently compounding each refresh.
local original_frac_values = {}


-- =========================
-- Helpers
-- =========================

local function get_current_armor()
    local actor = db.actor
    return actor and actor:item_in_slot(7) or nil
end


local function get_safe_active_weapon()
    local actor = db.actor
    if not actor then
        return nil
    end

    local ok, weapon = pcall(function()
        return actor:active_item()
    end)

    if not ok or not weapon then
        return nil
    end

    local ok2, wpn = pcall(function()
        return weapon:cast_Weapon()
    end)

    if not ok2 or not wpn then
        return nil
    end

    return weapon
end


-- The component recoil script exposes refresh_active_weapon().
-- If that namespace/function exists, component recoil owns the final
-- SetCam... values and armor should only provide its multiplier.
local function component_recoil_active()
    return obrien_component_based_recoil
       and type(obrien_component_based_recoil.refresh_active_weapon) == "function"
end


local function get_armor_multiplier()
    local armor = get_current_armor()
    local armor_section = armor and armor:section() or nil

    if armor_section and armor_recoil.armor_table[armor_section] then
        return armor_recoil.armor_table[armor_section], armor_section
    end

    return DEFAULT_MULT, armor_section
end


-- Public API used by Obrien Component Based Recoil.
function armor_recoil.get_current_multiplier()
    local mult = get_armor_multiplier()
    armor_recoil.current_mult = mult
    return mult
end

-- Public module API.
-- With this file named armor_recoil.script, other scripts can call:
-- armor_recoil.get_current_multiplier()
function get_current_multiplier()
    return armor_recoil.get_current_multiplier()
end


-- =========================
-- Standalone _frac handling
-- =========================

local function capture_original_fracs(weapon)
    if not weapon then
        return nil
    end

    local id = weapon:id()

    if original_frac_values[id] then
        return original_frac_values[id]
    end

    local wpn = weapon:cast_Weapon()
    if not wpn then
        return nil
    end

    original_frac_values[id] = {
        cam_dispersion_frac =
            wpn:GetCamDispersionFrac(),

        zoom_cam_dispersion_frac =
            wpn:GetZoomCamDispersionFrac(),
    }

    return original_frac_values[id]
end


local function apply_standalone_frac_multiplier(weapon, mult)
    if not weapon then
        return
    end

    local wpn = weapon:cast_Weapon()
    if not wpn then
        return
    end

    local base = capture_original_fracs(weapon)
    if not base then
        return
    end

    wpn:SetCamDispersionFrac(
        base.cam_dispersion_frac * mult
    )

    wpn:SetZoomCamDispersionFrac(
        base.zoom_cam_dispersion_frac * mult
    )
end


-- If another system changed the weapon's frac values (for example an upgrade)
-- while this armor script was active, forget the cached values when the weapon
-- changes so the next instance gets its own proper baseline.
local function clear_weapon_cache(weapon)
    if not weapon then
        return
    end

    original_frac_values[weapon:id()] = nil
end


-- =========================
-- Main update
-- =========================

function armor_recoil.update_if_needed(force)
    local weapon = get_safe_active_weapon()
    if not weapon then
        return
    end

    local weapon_id = weapon:id()

    local new_mult, armor_section =
        get_armor_multiplier()

    local changed =
        force
        or weapon_id ~= armor_recoil.current_weapon_id
        or armor_section ~= armor_recoil.current_armor_section
        or new_mult ~= armor_recoil.current_mult

    if not changed then
        return
    end

    armor_recoil.current_weapon_id = weapon_id
    armor_recoil.current_armor_section = armor_section
    armor_recoil.current_mult = new_mult

    if component_recoil_active() then
        -- Component recoil owns the runtime recoil fields and neutralizes
        -- engine _frac to 1.0.  Do not fight it here; simply request a fresh
        -- calculation, where this armor multiplier will be folded in once.
        dlog(string.format(
            "ARMOR_RECOIL | component mode | Armor=%s | Multiplier=%.3f",
            tostring(armor_section or "nil"),
            new_mult
        ))

        obrien_component_based_recoil.refresh_active_weapon()
        return
    end

    -- Standalone behavior: armor affects ONLY the two recoil frac fields.
    apply_standalone_frac_multiplier(
        weapon,
        new_mult
    )

    dlog(string.format(
        "ARMOR_RECOIL | standalone mode | Weapon=%s | Armor=%s | Multiplier=%.3f",
        tostring(weapon:section()),
        tostring(armor_section or "nil"),
        new_mult
    ))
end


-- =========================
-- Callbacks
-- =========================

local function actor_on_weapon_before_fire(params)
    armor_recoil.update_if_needed(false)
end


local function actor_item_to_slot(obj)
    nextTick(function()
        armor_recoil.update_if_needed(true)
        return true
    end)
end


local function actor_item_to_ruck(obj)
    if obj then
        clear_weapon_cache(obj)
    end

    armor_recoil.current_weapon_id = nil
end


local function actor_on_first_update()
    nextTick(function()
        armor_recoil.update_if_needed(true)
        return true
    end, 5)
end


function on_game_start()
    RegisterScriptCallback(
        "actor_on_weapon_before_fire",
        actor_on_weapon_before_fire
    )

    RegisterScriptCallback(
        "actor_item_to_slot",
        actor_item_to_slot
    )

    RegisterScriptCallback(
        "actor_item_to_ruck",
        actor_item_to_ruck
    )

    RegisterScriptCallback(
        "actor_on_first_update",
        actor_on_first_update
    )

    dlog("ARMOR_RECOIL | callbacks registered | API=get_current_multiplier")
end
