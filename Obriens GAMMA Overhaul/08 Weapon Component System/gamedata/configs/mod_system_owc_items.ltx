;======================================================================
; OBRIEN GENERIC WEAPON COMPONENT ITEMS
; Location: gamedata\configs\mod_system_owc_items.ltx
;
; Item owns:
;   slot
;   component type / physical compatibility
;   optional HUD child model (owc_model)
;   recoil profile (used only when recoil module is installed)
;
; Weapon owns compatibility and mount transforms.  The component item section
; name is automatically used for optional per-item mount overrides.
; Components without owc_model are valid recoil/logical-only parts.
;======================================================================

;======================================================================
; SHARED COMPONENT BASE
;======================================================================

[owc_item_base]:addon
visual = UPDATE
icons_texture = UPDATE
inv_grid_width = UPDATE
inv_grid_height = UPDATE
inv_grid_x = UPDATE
inv_grid_y = UPDATE
repair_type = scope
owc_attachment = true

